# ─── Krishi-Shetra frontend — environment variables ──────────────────────────
# Copy to `.env.local` for local dev, and set the same keys in your host
# (e.g. Vercel → Project → Settings → Environment Variables) for production.
# NOTE: every var here is prefixed NEXT_PUBLIC_, so it is embedded in the
# browser bundle at build time. Do NOT put true secrets in NEXT_PUBLIC_ vars.

# Vapi voice assistant (browser SDK)
NEXT_PUBLIC_VAPI_PUBLIC_KEY=your-vapi-public-key
NEXT_PUBLIC_VAPI_ASSISTANT_ID=your-vapi-assistant-id

# Vapi outbound-call credentials (used by /api/call route handler)
NEXT_PUBLIC_VAPI_PRIVATE_KEY=your-vapi-private-key
NEXT_PUBLIC_VAPI_PHONE_NUMBER_ID=your-vapi-phone-number-id

# Backends — must be publicly reachable URLs in production (not localhost)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
NEXT_PUBLIC_AI_URL=http://localhost:8000

# Processor app (login redirects Processor-role users here)
NEXT_PUBLIC_PROCESSOR_URL=http://localhost:8081

# Supabase (email-OTP auth in lib/emailOtpAuth.ts)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
